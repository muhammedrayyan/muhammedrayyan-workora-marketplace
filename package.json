{
  "name": "workora-marketplace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/serve-goworkora.mjs",
    "dev:goworkora": "node scripts/serve-goworkora.mjs",
    "dev:background": "node scripts/manage-goworkora-server.mjs start",
    "dev:status": "node scripts/manage-goworkora-server.mjs status",
    "dev:stop": "node scripts/manage-goworkora-server.mjs stop",
    "dev:legacy": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "static:sync": "node scripts/sync-goworkora-static.mjs",
    "static:check": "node scripts/sync-goworkora-static.mjs --check",
    "config:generate": "node scripts/generate-goworkora-config.mjs",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:run": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "demo:enable": "node scripts/demo-data.mjs enable",
    "demo:seed": "node scripts/demo-data.mjs seed",
    "demo:verify": "node scripts/demo-data.mjs verify",
    "demo:cleanup:preview": "node scripts/demo-data.mjs preview-cleanup",
    "demo:cleanup": "node scripts/demo-data.mjs remove",
    "demo:reset": "node scripts/demo-data.mjs reset",
    "demo:communications:diagnose": "node scripts/communication-demo.mjs diagnose",
    "demo:communications:seed": "node scripts/communication-demo.mjs seed",
    "demo:communications:verify": "node scripts/communication-demo.mjs verify",
    "demo:communications:cleanup:preview": "node scripts/communication-demo.mjs preview-cleanup",
    "demo:communications:cleanup": "node scripts/communication-demo.mjs remove",
    "auth:provision-admin": "node scripts/provision-admin.mjs provision",
    "auth:verify-admin": "node scripts/provision-admin.mjs verify"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
